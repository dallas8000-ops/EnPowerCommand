# When the API runs on a different port, point the Vite dev proxy at it (must match server/.env PORT)
# VITE_API_PROXY_TARGET=http://localhost:3003

# Production / split hosting: full origin of the API (no trailing slash). Required for Render static site builds.
# Example: https://enpower-command-api.onrender.com
# VITE_API_URL=
