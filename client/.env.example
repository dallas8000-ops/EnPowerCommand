# When the API runs on a different port, point the Vite dev proxy at it (must match server/.env PORT)
# VITE_API_PROXY_TARGET=http://localhost:3003

# Production / split hosting: full origin of the API (no trailing slash). Required for Railway client builds.
# Example: https://enpowercommand-production.up.railway.app
# VITE_API_URL=
