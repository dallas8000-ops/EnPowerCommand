PORT=3002
# If 3002 is in use, set e.g. PORT=3003 and set client/.env VITE_API_PROXY_TARGET=http://localhost:3003

# Auth: set AUTH_SECRET for production-style login. Use SKIP_AUTH for local dev.
# SKIP_AUTH=true
# AUTH_SECRET=replace-with-random-32-chars-minimum

# Local dev (recommended): docker compose up -d, then npm run db:init
DATABASE_URL=postgresql://enpower:enpower@localhost:5433/enpower
DB_SSL=false

# Deployment-Stripe-center (project: enpowercommand) provisions Stripe + Railway.
# stripe.config.json — tiers and URLs (edit in automation UI or here)
# See docs/STRIPE-SETUP.md

# Optional — when set, POST /api/outreach uses the API; otherwise demo copy is returned
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated origins for production; dev uses permissive CORS
CORS_ORIGIN=http://localhost:5173
