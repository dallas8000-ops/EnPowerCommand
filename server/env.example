PORT=3002
# If 3002 is in use, set e.g. PORT=3003 and set client/.env VITE_API_PROXY_TARGET=http://localhost:3003
DATABASE_URL=postgresql://enpower:enpower@localhost:5433/enpower

# Auth: set both for production-style login. Omit or use SKIP_AUTH for local dev.
# SKIP_AUTH=true
# AUTH_SECRET=replace-with-random-32-chars-minimum
# ADMIN_PASSWORD=replace-with-strong-password

# Optional — when set, POST /api/outreach uses the API; otherwise demo copy is returned
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated origins for production; dev uses permissive CORS
CORS_ORIGIN=http://localhost:5173
